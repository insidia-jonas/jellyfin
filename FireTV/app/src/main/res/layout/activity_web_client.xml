<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_jellyfin" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/connecting" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_form"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                style="@style/Widget.JellyfinFireTv.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_kicker" />

            <TextView
                android:id="@+id/errorTitle"
                style="@style/Widget.JellyfinFireTv.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/webview_error_title" />

            <TextView
                android:id="@+id/errorText"
                style="@style/Widget.JellyfinFireTv.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/webview_error" />

            <Button
                android:id="@+id/retryButton"
                style="@style/Widget.JellyfinFireTv.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/retry" />

            <Button
                android:id="@+id/errorChangeServerButton"
                style="@style/Widget.JellyfinFireTv.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/change_server" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/tv_rail_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/bg_rail"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Widget.JellyfinFireTv.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_kicker" />

            <TextView
                style="@style/Widget.JellyfinFireTv.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/client_menu" />

            <TextView
                android:id="@+id/menuVersion"
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Version 1.4.0" />

            <TextView
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/client_menu_help" />

            <Button
                android:id="@+id/menuReload"
                style="@style/Widget.JellyfinFireTv.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/reload" />

            <Button
                android:id="@+id/menuDownloads"
                style="@style/Widget.JellyfinFireTv.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/downloads" />

            <Button
                android:id="@+id/menuChangeServer"
                style="@style/Widget.JellyfinFireTv.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/change_server" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/menuExit"
                style="@style/Widget.JellyfinFireTv.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exit" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/downloadsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/tv_panel_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_rail"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Widget.JellyfinFireTv.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_kicker" />

            <TextView
                style="@style/Widget.JellyfinFireTv.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/downloads" />

            <TextView
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/downloads_help" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/downloadsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/downloadsEmpty"
                style="@style/Widget.JellyfinFireTv.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/downloads_empty"
                android:visibility="gone" />

            <Button
                android:id="@+id/menuCloseDownloads"
                style="@style/Widget.JellyfinFireTv.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/close" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
