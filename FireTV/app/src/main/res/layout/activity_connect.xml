<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.40"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_overscan"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_jellyfin" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/connect_kicker" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/connect_title"
            android:textSize="32sp" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/connect_subtitle" />

        <TextView
            android:id="@+id/versionText"
            style="@style/Widget.JellyfinFireTv.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            tools:text="Version 1.4.0" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.60"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/tv_overscan"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_form"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                style="@style/Widget.JellyfinFireTv.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect_form_title"
                android:textSize="24sp" />

            <TextView
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/server_url_label" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/server_url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:nextFocusDown="@id/connectButton" />

            <CheckBox
                android:id="@+id/ignoreSsl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:minHeight="52dp"
                android:text="@string/ignore_ssl"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connectButton"
                    style="@style/Widget.JellyfinFireTv.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/connect" />

                <Button
                    android:id="@+id/discoverButton"
                    style="@style/Widget.JellyfinFireTv.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/discover" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                style="@style/Widget.JellyfinFireTv.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:text="Connecting…"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/foundLabel"
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/found_servers"
                android:textAllCaps="true"
                android:textColor="@color/accent_soft"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/serverList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
