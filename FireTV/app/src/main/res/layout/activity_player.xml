<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_jellyfin" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/loadingTitle"
            style="@style/Widget.JellyfinFireTv.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/loadingHint"
            style="@style/Widget.JellyfinFireTv.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/preparing_playback" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="56dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/osdTitle"
            style="@style/Widget.JellyfinFireTv.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            tools:text="Arrival" />

        <TextView
            android:id="@+id/osdMeta"
            style="@style/Widget.JellyfinFireTv.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Deutsch · Untertitel aus" />

        <SeekBar
            android:id="@+id/osdSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:progressDrawable="@drawable/bg_seek"
            android:thumb="@drawable/bg_seek_thumb"
            android:thumbOffset="9dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/osdPlayState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/accent_soft"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="▶" />

            <TextView
                android:id="@+id/osdTime"
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                tools:text="24:10 / 1:52:00" />

            <TextView
                android:id="@+id/osdRemaining"
                style="@style/Widget.JellyfinFireTv.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="−1:27:50" />
        </LinearLayout>

        <TextView
            android:id="@+id/osdHints"
            style="@style/Widget.JellyfinFireTv.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/player_hints" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/trackPanel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            style="@style/Widget.JellyfinFireTv.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/client_menu" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tracks_title"
            android:textSize="24sp" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tracks_subtitle" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/trackList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_search_panel"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            style="@style/Widget.JellyfinFireTv.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/track_subtitles" />

        <TextView
            style="@style/Widget.JellyfinFireTv.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle_search_title" />

        <TextView
            android:id="@+id/searchStatus"
            style="@style/Widget.JellyfinFireTv.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/subtitle_search_pick_language" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/languageRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/searchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
