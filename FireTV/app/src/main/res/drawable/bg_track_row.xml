<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#385179" android:endColor="#263E60" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#CADFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#385179" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#26364E" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="#526B90" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#18283B50" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="#253F536D" /></shape>
    </item>
</selector>
